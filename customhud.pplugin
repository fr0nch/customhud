{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "0.5.0",
	"name": "customhud",
	"description": "Bridge to CS Script for controlling custom_hud_layout from plugins in any language",
	"author": "Fr4nch",
	"website": "https://github.com/fr0nch",
	"license": "GPLv3",
	"entry": "customhud.CustomHud",
	"platforms": [],
	"language": "javascript",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.0"
		}
	],
	"prototypes": [
		{
			"name": "OnCsScriptReadyCallback",
			"funcName": "OnCsScriptReadyCallback",
			"description": "CS Script has come up and is ready to use.",
			"paramTypes": [],
			"retType": {
				"type": "void"
			}
		},
		{
			"name": "OnHudClickedCallback",
			"funcName": "OnHudClickedCallback",
			"description": "A hud button click. Called when a button in a CustomHudLayout is clicked.",
			"paramTypes": [
				{
					"name": "playerSlot",
					"type": "int32",
					"description": "Slot of the player who clicked."
				},
				{
					"name": "hud",
					"type": "int32",
					"description": "Handle of the clicked hud."
				},
				{
					"name": "buttonId",
					"type": "string",
					"description": "The id attribute of the clicked button in the layout."
				}
			],
			"retType": {
				"type": "void"
			}
		}
	],
	"methods": [
		{
			"name": "IsCsScriptReady",
			"description": "Checks whether the CS Script system has come up and the plugin is connected to it.",
			"funcName": "IsCsScriptReady",
			"paramTypes": [],
			"retType": {
				"type": "bool",
				"description": "True if Instance is available."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "OnCsScriptReady_Register",
			"description": "Subscribes a callback to be called every time CS Script comes up (once per map, since it has to reconnect after every map change). If CS Script is already ready at the time of registration, the callback fires immediately.",
			"funcName": "OnCsScriptReady_Register",
			"paramTypes": [
				{
					"name": "callback",
					"type": "function",
					"ref": false,
					"description": "Called when CS Script is ready.",
					"prototype": "OnCsScriptReadyCallback"
				}
			],
			"retType": {
				"type": "void"
			},
			"group": "Listeners"
		},
		{
			"name": "OnCsScriptReady_Unregister",
			"description": "Removes a callback previously added with OnCsScriptReady_Register.",
			"funcName": "OnCsScriptReady_Unregister",
			"paramTypes": [
				{
					"name": "callback",
					"type": "function",
					"ref": false,
					"description": "The exact callback reference passed to OnCsScriptReady_Register.",
					"prototype": "OnCsScriptReadyCallback"
				}
			],
			"retType": {
				"type": "void"
			},
			"group": "Listeners"
		},
		{
			"name": "CreateCustomHud",
			"description": "Creates a custom_hud_layout entity with the given Panorama layout and returns its handle. The handle is used for all further calls to this hud and stays valid until the hud is removed or the map changes. cs_script cannot spawn entities, so creation goes through s2sdk.",
			"funcName": "CreateCustomHud",
			"paramTypes": [
				{
					"name": "name",
					"type": "string",
					"ref": false,
					"description": "Name (targetname) of the hud. Does not have to be unique."
				},
				{
					"name": "layoutResource",
					"type": "string",
					"ref": false,
					"description": "Path to the Panorama layout (.xml), declared as a resource in the session manifest."
				}
			],
			"retType": {
				"type": "int32",
				"description": "Hud handle, or -1 if the hud could not be created."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "FindCustomHud",
			"description": "Gets the handle of the first hud with this name (targetname), such as a hud placed on the map.",
			"funcName": "FindCustomHud",
			"paramTypes": [
				{
					"name": "name",
					"type": "string",
					"ref": false,
					"description": "The hud's targetname."
				}
			],
			"retType": {
				"type": "int32",
				"description": "Hud handle, or -1 if there is no hud with this name."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "RemoveCustomHud",
			"description": "Removes a hud.",
			"funcName": "RemoveCustomHud",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "HideCustomHudFromOtherPlayers",
			"description": "Hides the hud entity from all players except the owner, at the transmit/PVS level. A stronger guarantee than a CSS class, which only hides the panel on clients the entity is still transmitted to. (s2sdk.HideTransmitEntityFromOtherPlayers)",
			"funcName": "HideCustomHudFromOtherPlayers",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "The owner player slot who will still see the entity."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "SetHudHasClass",
			"description": "Set if a panel has a class. Applies to all players. (CustomHudLayout.SetHasClass)",
			"funcName": "SetHudHasClass",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "className",
					"type": "string",
					"ref": false,
					"description": "CSS class."
				},
				{
					"name": "hasClass",
					"type": "bool",
					"ref": false,
					"description": "True to add the class, false to remove it."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "ResetHudHasClass",
			"description": "Revert a panel's class to the original value from the layout. Applies to all players. (CustomHudLayout.SetHasClass without hasClass)",
			"funcName": "ResetHudHasClass",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "className",
					"type": "string",
					"ref": false,
					"description": "CSS class."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "SetHudDialogVariable",
			"description": "Set the value of a dialog variable. Applies to all players. In the layout it's read as text=\"{s:variableName}\". (CustomHudLayout.SetDialogVariableString)",
			"funcName": "SetHudDialogVariable",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "variableName",
					"type": "string",
					"ref": false,
					"description": "Variable name."
				},
				{
					"name": "value",
					"type": "string",
					"ref": false,
					"description": "Value to display."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "SetHudHasClassForPlayer",
			"description": "Set if a panel has a class for a single player. Will override the all player value. (CustomHudLayout.SetHasClassForPlayer)",
			"funcName": "SetHudHasClassForPlayer",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot the override applies to."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "className",
					"type": "string",
					"ref": false,
					"description": "CSS class."
				},
				{
					"name": "hasClass",
					"type": "bool",
					"ref": false,
					"description": "True to add the class, false to remove it."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "ResetHudHasClassForPlayer",
			"description": "Remove a single player's value of a panel's class, so the all player value applies again. (CustomHudLayout.SetHasClassForPlayer without hasClass)",
			"funcName": "ResetHudHasClassForPlayer",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot the override applies to."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "className",
					"type": "string",
					"ref": false,
					"description": "CSS class."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "BHasClass",
			"description": "Get if a panel has a class for a player. The player value is used if set, otherwise the all player value. Classes from the layout file are not known to the server and are not reported. (Panel.BHasClass)",
			"funcName": "BHasClass",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot, or -1 for the all player value."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "className",
					"type": "string",
					"ref": false,
					"description": "CSS class."
				}
			],
			"retType": {
				"type": "bool",
				"description": "True if the class is set. False if it isn't, or the handle isn't a hud."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "ToggleClass",
			"description": "Toggle a class on a panel, based on the value reported by BHasClass. Pass -1 for `playerSlot` to toggle the all player value. (Panel.ToggleClass)",
			"funcName": "ToggleClass",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot, or -1 for the all player value."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "className",
					"type": "string",
					"ref": false,
					"description": "CSS class."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "SetHudDialogVariableForPlayer",
			"description": "Set the value of a dialog variable for a single player. Will override the all player value. (CustomHudLayout.SetDialogVariableStringForPlayer)",
			"funcName": "SetHudDialogVariableForPlayer",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot the override applies to."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "variableName",
					"type": "string",
					"ref": false,
					"description": "Variable name."
				},
				{
					"name": "value",
					"type": "string",
					"ref": false,
					"description": "Value to display."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "ResetHudDialogVariableForPlayer",
			"description": "Remove a single player's value of a dialog variable, so the all player value applies again. If no all player value has been set, the value will be an empty string. (CustomHudLayout.SetDialogVariableStringForPlayer without value)",
			"funcName": "ResetHudDialogVariableForPlayer",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot the override applies to."
				},
				{
					"name": "panelId",
					"type": "string",
					"ref": false,
					"description": "The panel's id attribute in the layout."
				},
				{
					"name": "variableName",
					"type": "string",
					"ref": false,
					"description": "Variable name."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "SetHudInputCapture",
			"description": "Set to true to force a player into cursor mode and enable click detection on the panels of this hud. Set a callback with OnHudClicked_Register to listen for clicks. Multiple huds can have input captured at a time. Players will get movement control back once all huds have disabled input capture. (CustomHudLayout.SetInputCaptureEnabled)",
			"funcName": "SetHudInputCapture",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot."
				},
				{
					"name": "enabled",
					"type": "bool",
					"ref": false,
					"description": "True to capture input, false to release control."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "IsHudInputCaptureEnabled",
			"description": "Get if this hud is capturing input for a player. (CustomHudLayout.IsInputCaptureEnabled)",
			"funcName": "IsHudInputCaptureEnabled",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if input isn't captured, the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "ResetHud",
			"description": "Reset to original state for all players. (CustomHudLayout.Reset)",
			"funcName": "ResetHud",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "ResetHudForPlayer",
			"description": "Reset a single player's overrides to their original state. (CustomHudLayout.ResetForPlayer)",
			"funcName": "ResetHudForPlayer",
			"paramTypes": [
				{
					"name": "hud",
					"type": "int32",
					"ref": false,
					"description": "Hud handle from CreateCustomHud or FindCustomHud."
				},
				{
					"name": "playerSlot",
					"type": "int32",
					"ref": false,
					"description": "Player slot whose overrides are reset."
				}
			],
			"retType": {
				"type": "bool",
				"description": "False if the handle isn't a hud, CS Script isn't ready or the call failed."
			},
			"group": "CustomHudLayout"
		},
		{
			"name": "OnHudClicked_Register",
			"description": "Subscribes to button clicks on all huds. Replaces a separate cs_script relay and ServerCommand: the click arrives directly in this plugin through Instance.OnCustomHudClicked.",
			"funcName": "OnHudClicked_Register",
			"paramTypes": [
				{
					"name": "callback",
					"type": "function",
					"ref": false,
					"description": "Called on every click.",
					"prototype": "OnHudClickedCallback"
				}
			],
			"retType": {
				"type": "void"
			},
			"group": "Listeners"
		},
		{
			"name": "OnHudClicked_Unregister",
			"description": "Removes a callback previously added with OnHudClicked_Register.",
			"funcName": "OnHudClicked_Unregister",
			"paramTypes": [
				{
					"name": "callback",
					"type": "function",
					"ref": false,
					"description": "The exact callback reference passed to OnHudClicked_Register.",
					"prototype": "OnHudClickedCallback"
				}
			],
			"retType": {
				"type": "void"
			},
			"group": "Listeners"
		}
	]
}
